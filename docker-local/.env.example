# Copy to docker-local/.env and adjust. docker-local/.env is not committed.

# Your WSL user and group IDs (`id -u` and `id -g`). Containers run as this
# user so files they create in the project are owned by you, not root.
HOST_UID=1000
HOST_GID=1000

# Host ports, bound to 127.0.0.1 only.
APP_PORT=80
VITE_PORT=5173
MYSQL_HOST_PORT=3307

# MySQL. These must match DB_DATABASE / DB_USERNAME / DB_PASSWORD in the
# Laravel .env at the project root.
MYSQL_DATABASE=rasahub
MYSQL_USER=rasahub
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
